PORT=4317
# Set a strong local access token. Without one, a random token is printed on startup.
ATTENTION_TOKEN=
# Default: memory, private session. infra enables PostgreSQL/Redis/RabbitMQ.
STORAGE_MODE=memory
DATABASE_URL=postgresql://attention:attention_local@127.0.0.1:5432/attention
REDIS_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://attention:attention_local@127.0.0.1:5672
RETENTION_HOURS=24
# Speech-to-text chain for the Python worker (default: local only).
# Remote entries send audio off the machine; they are skipped without a key.
# STT_PROVIDERS=groq,faster-whisper
STT_PROVIDERS=faster-whisper
STT_LANGUAGE=pt
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE=int8
# GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENAI_STT_MODEL=whisper-1

# ---- External AI (optional). Keys stay here, never in code. Even with keys set,
# nothing leaves the machine until "IA externa" is switched on in the UI.
# Ordered fallback chains (ids below). Defaults shown.
# AI_CHEAP=groq,gemini
# AI_STRONG=anthropic,gemini-pro,openrouter
# Spec shorthand: a single strong provider and model.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_PRO_MODEL=gemini-pro-latest
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OpenAI and xAI are enabled only with an explicit model name.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# XAI_API_KEY=
# XAI_MODEL=
# DEEPSEEK_API_KEY=
# Optional USD per million tokens, for cost estimates of providers that do not
# report cost themselves (Anthropic uses its published table; OpenRouter reports).
# GROQ_PRICE_IN=
# GROQ_PRICE_OUT=
