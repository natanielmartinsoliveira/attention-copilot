{
  "name": "attention-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/core"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:api && concurrently -k \"node --env-file-if-exists=.env dist/apps/api/src/main.js\" \"vite --config apps/desktop/vite.config.ts\"",
    "build:api": "tsc -p tsconfig.api.json",
    "build": "npm run build:api && vite build --config apps/desktop/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "test": "vitest run",
    "check": "tsc --noEmit -p apps/desktop/tsconfig.json && npm run build:api",
    "desktop": "cd apps/desktop && tauri dev",
    "test:integration": "node tests/integration/api.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "amqplib": "^0.10.8",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
